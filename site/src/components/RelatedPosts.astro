---
import type { Post } from '../lib/posts';
import { categoryName } from '../lib/posts';

interface Props {
  posts: Post[];
  heading?: string;
}

const { posts, heading = 'あわせて読みたい' } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="my-10" aria-labelledby="related-heading">
      <h2 id="related-heading">{heading}</h2>
      <ul class="not-prose grid gap-3 sm:grid-cols-2">
        {posts.map((post) => (
          <li class="group relative rounded-lg border border-neutral-200 bg-white p-4 transition-colors hover:border-brand-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-brand-700">
            <p class="mb-1 text-xs font-semibold text-brand-700 dark:text-brand-400">
              {categoryName(post.data.category)}
            </p>
            <p class="text-[0.95rem] leading-snug font-bold text-neutral-900 group-hover:text-brand-700 dark:text-neutral-100 dark:group-hover:text-brand-300">
              <a href={`/posts/${post.id}`} class="after:absolute after:inset-0">
                {post.data.title}
              </a>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
