---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrDisclosure from '../../components/PrDisclosure.astro';
import KeyPoints from '../../components/KeyPoints.astro';
import Toc from '../../components/Toc.astro';
import Faq from '../../components/Faq.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getPosts, relatedPosts, categoryName, readingMinutes } from '../../lib/posts';
import { formatDate } from '../../lib/format';
import * as schema from '../../lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, all }: Props = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const url = `/posts/${post.id}`;
const related = relatedPosts(post, all);
const minutes = readingMinutes(post.body ?? '');

const trail = [
  { name: 'ホーム', href: '/' },
  { name: categoryName(d.category), href: `/category/${d.category}` },
  { name: d.title },
];

const jsonLd = schema.graph([
  schema.organization(),
  schema.website(),
  schema.person(),
  schema.breadcrumbs(trail),
  schema.article({
    title: d.title,
    description: d.description,
    url,
    image: d.heroImage?.src,
    publishDate: d.publishDate,
    updatedDate: d.updatedDate,
  }),
  schema.faqPage(d.faq),
  schema.itemList(d.products, url),
]);
---

<BaseLayout
  narrow
  title={d.title}
  description={d.description}
  type="article"
  image={d.heroImage?.src}
  noindex={d.noindex || d.draft}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  jsonLd={jsonLd}
>
  <Breadcrumbs trail={trail} />

  <article>
    <header class="mb-6">
      <h1 class="text-2xl leading-snug font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-50">
        {d.title}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500 dark:text-neutral-400">
        <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)} 公開</time>
        {
          d.updatedDate && (
            <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)} 更新</time>
          )
        }
        <span>約{minutes}分で読めます</span>
      </div>

      {
        d.heroImage && (
          <Image
            src={d.heroImage}
            alt={d.heroImageAlt ?? ''}
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="mt-5 w-full rounded-xl object-cover"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </header>

    {d.hasAffiliate && <PrDisclosure />}

    <KeyPoints points={d.keyPoints} />
    <Toc headings={headings} />

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      {
        d.products.length > 1 && (
          <ComparisonTable products={d.products} caption="まずは一覧で比較" />
        )
      }

      <Content />

      <Faq items={d.faq} />
      <RelatedPosts posts={related} />
    </div>
  </article>
</BaseLayout>
