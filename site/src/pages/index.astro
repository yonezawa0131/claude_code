---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE, CATEGORIES } from '../consts';
import * as schema from '../lib/schema';

const posts = await getPosts();
const [featured, ...rest] = posts;

const jsonLd = schema.graph([schema.organization(), schema.website(), schema.person()]);
---

<BaseLayout bare title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="mb-10">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{SITE.name}</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-neutral-600 dark:text-neutral-400">
      {SITE.description}
    </p>
  </section>

  {
    CATEGORIES.length > 0 && (
      <nav aria-label="カテゴリ一覧" class="mb-10">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {CATEGORIES.map((c) => (
            <li class="group relative rounded-xl border border-neutral-200 p-4 transition-colors hover:border-brand-400 dark:border-neutral-800 dark:hover:border-brand-600">
              <p class="font-bold text-neutral-900 group-hover:text-brand-700 dark:text-neutral-100 dark:group-hover:text-brand-300">
                <a href={`/category/${c.slug}`} class="after:absolute after:inset-0">
                  {c.name}
                </a>
              </p>
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{c.description}</p>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <section aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="mb-4 text-xl font-bold">新着記事</h2>
    {
      posts.length === 0 ? (
        <p class="text-neutral-600 dark:text-neutral-400">準備中です。</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2">
          {featured && <PostCard post={featured} featured />}
          {rest.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
